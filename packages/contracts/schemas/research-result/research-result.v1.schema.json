{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexus.research-result.v1",
  "title": "Nexus Grounded Research Result",
  "type": "object",
  "required": ["run_id", "project_id", "task_id", "agent_id", "status", "evidence_ids", "warnings"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 }, "project_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 }, "agent_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["OK", "EMPTY", "PARTIAL", "DEGRADED", "BLOCKED", "TIMEOUT"] },
    "evidence_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "summary": { "type": "string" }, "provenance": { "type": "object" }
  }
}
