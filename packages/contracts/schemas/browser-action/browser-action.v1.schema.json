{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexus.browser-action.v1",
  "title": "Nexus Typed Browser Action",
  "type": "object",
  "required": ["action_id", "session_id", "project_id", "task_id", "agent_id", "action_type", "risk_level", "target_origin", "parameters"],
  "properties": {
    "action_id": { "type": "string", "minLength": 1 }, "session_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 }, "task_id": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string", "minLength": 1 }, "action_type": { "type": "string", "minLength": 1 },
    "risk_level": { "enum": ["R0", "R1", "R2", "R3", "R4"] },
    "target_origin": { "type": "string", "minLength": 1 }, "parameters": { "type": "object" }
  }
}
