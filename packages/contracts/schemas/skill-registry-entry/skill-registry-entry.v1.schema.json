{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexus.skill-registry-entry.v1",
  "title": "Nexus Compact Skill Registry Entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["skill_id", "purpose", "task_types", "risk_levels", "dependencies", "conflicts", "precedence_owner", "estimated_context_cost", "version", "status"],
  "properties": {
    "skill_id": { "type": "string", "minLength": 1 }, "purpose": { "type": "string", "minLength": 1 },
    "task_types": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "risk_levels": { "type": "array", "items": { "enum": ["R0", "R1", "R2", "R3", "R4"] } },
    "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "conflicts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "precedence_owner": { "type": "string", "minLength": 1 },
    "estimated_context_cost": { "type": "integer", "minimum": 0 },
    "version": { "type": "string", "minLength": 1 }, "status": { "type": "string", "minLength": 1 }
  }
}
