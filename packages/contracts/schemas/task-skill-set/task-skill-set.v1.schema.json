{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexus.task-skill-set.v1",
  "title": "Nexus Task-Agent SkillSet",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "agent_id", "required", "optional", "forbidden", "loaded", "completed", "context_budget"],
  "properties": {
    "task_id": { "type": "string", "minLength": 1 }, "agent_id": { "type": "string", "minLength": 1 },
    "required": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "optional": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "forbidden": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "loaded": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "completed": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "context_budget": { "type": "object" }
  }
}
