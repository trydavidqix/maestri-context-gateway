{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexus.browser-observation.v1",
  "title": "Nexus Untrusted Browser Observation",
  "type": "object",
  "required": ["observation_id", "session_id", "project_id", "task_id", "agent_id", "url", "origin", "trust_level", "content_hash", "provenance"],
  "properties": {
    "observation_id": { "type": "string", "minLength": 1 }, "session_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 }, "task_id": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string", "minLength": 1 }, "url": { "type": "string", "minLength": 1 },
    "origin": { "type": "string", "minLength": 1 }, "title": { "type": "string" },
    "content_hash": { "type": "string", "minLength": 1 }, "trust_level": { "const": "UNTRUSTED" },
    "provenance": { "type": "object" }, "content": { "type": "string" },
    "accessibility": { "type": "string" }, "dom_excerpt": { "type": "string" }
  }
}
