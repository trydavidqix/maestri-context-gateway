{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexus.engineering-plan.v1",
  "title": "Nexus EngineeringPlan",
  "type": "object",
  "required": [
    "task_id",
    "agent_id",
    "task_type",
    "risk_level",
    "scope_size",
    "expected_files",
    "expected_tests",
    "contract_impact",
    "testability",
    "execution_mode",
    "autonomy_level",
    "skill_policy",
    "context_budget",
    "tool_profile",
    "verification_gates",
    "delivery_policy"
  ],
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string", "minLength": 1 },
    "task_type": {
      "enum": [
        "BUG",
        "FEATURE",
        "REFACTOR",
        "ARCHITECTURE",
        "REVIEW",
        "AUDIT",
        "PROTOTYPE",
        "MIGRATION",
        "BRANCH_INTEGRATION",
        "DEPENDENCY_CHANGE",
        "UI",
        "COPY",
        "TEST_ONLY",
        "PERFORMANCE",
        "SECURITY_RELATED"
      ]
    },
    "risk_level": { "enum": ["R0", "R1", "R2", "R3", "R4"] },
    "scope_size": { "type": "string", "minLength": 1 },
    "expected_files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "expected_tests": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "contract_impact": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "testability": { "type": "string", "minLength": 1 },
    "execution_mode": { "enum": ["read_only", "write"] },
    "autonomy_level": { "enum": ["A0", "A1", "A2", "A3", "A4"] },
    "skill_policy": {
      "type": "object",
      "required": ["required", "optional", "forbidden", "loaded", "completed"],
      "properties": {
        "required": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "optional": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "forbidden": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "loaded": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "completed": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "context_budget": {
      "type": "object",
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "context_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "definitions": { "type": "integer", "minimum": 0 },
        "calls": { "type": "integer", "minimum": 0 },
        "seconds": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "tool_profile": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "verification_gates": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "delivery_policy": { "type": "object" }
  }
}
