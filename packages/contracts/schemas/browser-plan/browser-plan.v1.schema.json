{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexus.browser-plan.v1",
  "title": "Nexus BrowserPlan",
  "type": "object",
  "required": [
    "browser_task_id", "project_id", "task_id", "agent_id", "intent", "risk_level", "autonomy_level",
    "allowed_origins", "allowed_redirect_origins", "blocked_origins", "download_origins", "upload_origins",
    "interaction_mode", "observation_mode", "backend_preference", "host_requirements", "profile_policy",
    "secret_policy", "tool_profile", "context_budget", "max_actions", "max_pages", "max_runtime",
    "max_browser_seconds", "max_cost", "approval_gates", "success_assertions", "stop_conditions"
  ],
  "properties": {
    "browser_task_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string", "minLength": 1 },
    "engineering_plan_id": { "type": "string", "minLength": 1 },
    "intent": { "type": "string", "minLength": 1 },
    "risk_level": { "enum": ["R0", "R1", "R2", "R3", "R4"] },
    "autonomy_level": { "enum": ["A0", "A1", "A2", "A3", "A4"] },
    "allowed_origins": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "allowed_redirect_origins": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "blocked_origins": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "download_origins": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "upload_origins": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "interaction_mode": { "type": "string", "minLength": 1 },
    "observation_mode": { "type": "string", "minLength": 1 },
    "backend_preference": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "host_requirements": { "type": "object" },
    "profile_policy": { "type": "object" },
    "secret_policy": { "type": "object" },
    "tool_profile": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "context_budget": { "type": "object" },
    "max_actions": { "type": "integer", "minimum": 0 },
    "max_pages": { "type": "integer", "minimum": 0 },
    "max_runtime": { "type": "number", "minimum": 0 },
    "max_browser_seconds": { "type": "number", "minimum": 0 },
    "max_cost": { "type": "number", "minimum": 0 },
    "approval_gates": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "success_assertions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "stop_conditions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
