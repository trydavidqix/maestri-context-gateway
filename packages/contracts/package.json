{
  "name": "@nexus-brain/contracts",
  "private": true,
  "type": "module",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs"
    },
    "./job": {
      "types": "./src/job.ts",
      "import": "./src/job.ts"
    },
    "./runtime": {
      "types": "./src/runtime.ts",
      "import": "./src/runtime.ts"
    },
    "./context/packet": "./src/context/packet.ts",
    "./execution/port": "./src/execution/port.ts",
    "./workforce/types": "./src/workforce/types.ts",
    "./schemas/*": "./schemas/*"
  },
  "scripts": {
    "test:unit": "node --test tests/*.test.mjs && vitest run contracts-types.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
